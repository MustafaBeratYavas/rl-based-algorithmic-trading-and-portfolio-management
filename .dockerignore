# Git and local editor state
.git/
.github/
.vscode/
.idea/
.editorconfig
.gitattributes
.gitignore

# Python build, cache, and virtual environment artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.venv/
.venv*/
venv/
env/

# Test, lint, type-check, and coverage outputs
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.pytest_tmp*/
.ruff_cache/
.mypy_cache/
.pyre/
.nox/
.tox/
.hypothesis/
junit.xml
*.cover

# Runtime datasets, model artifacts, and logs are mounted at runtime
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
logs/*
!logs/.gitkeep
!logs/tb_logs/
logs/tb_logs/*
!logs/tb_logs/.gitkeep
!logs/optuna_studies/
logs/optuna_studies/*
!logs/optuna_studies/.gitkeep
models/checkpoints/*
!models/checkpoints/.gitkeep
models/final/*
!models/final/.gitkeep

# Local config, notebook, and OS noise
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
desktop.ini
.ipynb_checkpoints/

# Temporary files
*.log
*.tmp
*.bak
_test_output.txt
_test_output/
test_results.txt
